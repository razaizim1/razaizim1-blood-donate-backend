model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
